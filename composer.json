{
    "name": "routewise/laravel",
    "description": "Turn a Laravel app into a safe MCP server: tools defined as data or generated from your routes, with kinds, a call log and a readiness scan.",
    "keywords": [
        "laravel",
        "mcp",
        "ai",
        "agents",
        "tools"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Mohab2Mamdouh/laravel-routewise",
    "support": {
        "issues": "https://github.com/Mohab2Mamdouh/laravel-routewise/issues",
        "source": "https://github.com/Mohab2Mamdouh/laravel-routewise"
    },
    "authors": [
        {
            "name": "Mohab Mamdouh",
            "homepage": "https://mohabmamdouh.me"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.41.1|^13.0",
        "illuminate/http": "^12.41.1|^13.0",
        "illuminate/routing": "^12.41.1|^13.0",
        "illuminate/support": "^12.41.1|^13.0",
        "illuminate/validation": "^12.41.1|^13.0",
        "laravel/mcp": "^1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8|^11.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "Routewise\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routewise\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Routewise\\RoutewiseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
